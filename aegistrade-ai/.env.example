# This is a TEMPLATE. Run `python scripts/bootstrap.py` to generate a private .env.
# Do not commit .env or provide tokens to other people.
AEGIS_DATA_SOURCE=synthetic
AEGIS_RETRIEVAL_MODE=offline
AEGIS_REVIEWER_TOKEN=SET_ME
AEGIS_GRAFANA_PASSWORD=SET_ME
AEGIS_DATA_DIR=data
AEGIS_API_URL=http://127.0.0.1:8000

# Optional, remains disabled by default. No API keys in GitHub.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Explicitly opt in to paid UI experiments after you have set a key and budget.
AEGIS_ENABLE_LLM_EXPERIMENTS=false

# Optional authored corpus and neural vector persistence (see viva guide).
# AEGIS_POLICY_CORPUS_PATH=data/policy_corpus.json
# AEGIS_QDRANT_URL=http://127.0.0.1:6333

# After first successful build: python -m scripts.build_rag_index --mode neural --activate
# Local Chroma and public model weights default to data/rag and data/model_cache.
# HF_HUB_OFFLINE=1  # enable only after the pretrained models are cached

# Inference transport at start-up: openrouter (default), codex_cli or claude_cli.
# The dashboard provider dropdown can switch it later without a restart; that choice is saved in data/inference_backend.json.
AEGIS_LLM_BACKEND=openrouter
# Optional selected model override. Leave blank for backend-specific default.
AEGIS_LLM_MODEL=
# For codex_cli: run codex login in Terminal using ChatGPT. No API key is needed.
# Set this if codex is not on PATH (e.g. the installed VS Code extension binary).
AEGIS_CODEX_BIN=
AEGIS_CODEX_TIMEOUT_SECONDS=120
# Optional supported CLI home; never copy OAuth tokens into .env.
# AEGIS_CODEX_HOME=
# For claude_cli: run `claude auth login` in Terminal with your Claude account. No API key is needed or forwarded.
# Set AEGIS_CLAUDE_BIN if claude is not on PATH. AEGIS_CLAUDE_MODEL is optional (blank = the CLI's default model).
AEGIS_CLAUDE_BIN=
AEGIS_CLAUDE_MODEL=
AEGIS_CLAUDE_TIMEOUT_SECONDS=120
# AEGIS_CLAUDE_HOME=

# Bounded dated public-web evidence fallback for code-qualified C2 cases. No search API key.
AEGIS_DATED_WEB_SEARCH=true
