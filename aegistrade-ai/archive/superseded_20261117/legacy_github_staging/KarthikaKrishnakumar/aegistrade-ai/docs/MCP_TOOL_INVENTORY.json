  {
    "server": "mcp_servers.market_server",
    "name": "assess_case",
    "permission": "read/compute",
    "exposed_to_llm": true,
    "description": "READ/COMPUTE: Validate and inspect the selected case; no future labels or writes.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "additionalProperties": false,
          "properties": {
            "symbol": {
              "pattern": "^[A-Z0-9][A-Z0-9_&-]{1,29}$",
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "regime": {
              "enum": [
                "TREND",
                "RANGE",
                "BREAKOUT",
                "HIGH_VOL",
                "UNCERTAIN",
                "WARMUP"
              ],
              "type": "string"
            },
            "Close": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "RSI14": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "ADX14": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "EMA20": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "EMA50": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "ATR14": {
              "minimum": 0,
              "type": "number"
            },
            "research_purpose": {
              "default": "ENTRY",
              "enum": [
                "ENTRY",
                "HOLDING_REVIEW"
              ],
              "type": "string"
            },
            "holding_context": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "quantity": {
                      "exclusiveMinimum": 0,
                      "type": "integer"
                    },
                    "entry_price": {
                      "exclusiveMinimum": 0,
                      "type": "number"
                    },
                    "stop_price": {
                      "exclusiveMinimum": 0,
                      "type": "number"
                    },
                    "strategy": {
                      "enum": [
                        "EMA_TREND",
                        "RSI_REVERSION",
                        "BREAKOUT"
                      ],
                      "type": "string"
                    },
                    "holding_sessions": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "review_trigger": {
                      "maxLength": 120,
                      "type": "string"
                    }
                  },
                  "required": [
                    "quantity",
                    "entry_price",
                    "stop_price",
                    "strategy",
                    "holding_sessions",
                    "review_trigger"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "selection_score": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "selection_rank": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "average_turnover_20_inr": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "symbol",
            "date",
            "regime",
            "Close",
            "RSI14",
            "ADX14",
            "EMA20",
            "EMA50",
            "ATR14"
          ],
          "type": "object"
        }
      },
      "required": [
        "evidence"
      ],
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": true,
      "type": "object"
    }
  },
