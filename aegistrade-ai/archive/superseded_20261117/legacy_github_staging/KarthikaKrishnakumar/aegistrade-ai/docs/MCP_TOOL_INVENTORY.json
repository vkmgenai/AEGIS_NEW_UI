  {
    "server": "mcp_servers.risk_server",
    "name": "validate_simulated_buy",
    "permission": "read/compute",
    "exposed_to_llm": false,
    "description": "READ/COMPUTE: Validate a typed proposed BUY against deterministic risk policy.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "order": {
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "maxLength": 100,
              "minLength": 3,
              "type": "string"
            },
            "symbol": {
              "pattern": "^[A-Z0-9][A-Z0-9_&-]{1,29}$",
              "type": "string"
            },
            "side": {
              "enum": [
                "BUY",
                "SELL"
              ],
              "type": "string"
            },
            "quantity": {
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "integer"
            },
            "order_type": {
              "const": "MARKET",
              "default": "MARKET",
              "type": "string"
            },
            "reference_price": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "stop_loss_price": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "strategy": {
              "enum": [
                "EMA_TREND",
                "RSI_REVERSION",
                "BREAKOUT"
              ],
              "type": "string"
            },
            "account": {
              "const": "DEMO_ONLY",
              "default": "DEMO_ONLY",
              "type": "string"
            },
            "signal_date": {
              "type": "string"
            },
            "expires_at_utc": {
              "type": "string"
            }
          },
          "required": [
            "request_id",
            "symbol",
            "side",
            "quantity",
            "reference_price",
            "stop_loss_price",
            "strategy",
            "signal_date",
            "expires_at_utc"
          ],
          "type": "object"
        },
        "inputs": {
          "additionalProperties": false,
          "properties": {
            "equity": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "available_cash": {
              "minimum": 0,
              "type": "number"
            },
            "current_positions": {
              "minimum": 0,
              "type": "integer"
            },
            "portfolio_day_loss_pct": {
              "default": 0.0,
              "type": "number"
            }
          },
          "required": [
            "equity",
            "available_cash",
            "current_positions"
          ],
          "type": "object"
        }
      },
      "required": [
        "order",
        "inputs"
      ],
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": true,
      "type": "object"
    }
  },
