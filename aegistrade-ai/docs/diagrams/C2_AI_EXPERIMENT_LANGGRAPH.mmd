---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	plan(plan)
	market(market)
	strategy(strategy)
	validate_strategy(validate_strategy)
	replan(replan)
	critic(critic)
	__end__([<p>__end__</p>]):::last
	__start__ --> plan;
	market --> strategy;
	plan --> market;
	replan --> strategy;
	strategy --> validate_strategy;
	validate_strategy -.-> critic;
	validate_strategy -.-> replan;
	critic --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
